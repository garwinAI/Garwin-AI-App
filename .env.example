APP_ENV=local
APP_DEBUG=false
APP_URL=http://localhost:8000
SESSION_SECURE_COOKIE=false
APP_KEY=

# Set the password locally in .env before bootstrapping the first admin.
GARWIN_ADMIN_EMAIL=support@garwinai.com
GARWIN_ADMIN_PASSWORD=

# Local development:
DB_CONNECTION=sqlite
DB_DATABASE=var/garwin.sqlite

# Production MySQL/MariaDB configuration:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=garwin
# DB_USERNAME=garwin
# DB_PASSWORD=

# Production Neon PostgreSQL configuration. Set credentials as deployment secrets.
# The Neon Data API URL is not a database connection URL.
# DB_CONNECTION=pgsql
# DB_HOST=your-neon-postgres-host
# DB_PORT=5432
# DB_DATABASE=neondb
# DB_USERNAME=your-neon-role
# DB_PASSWORD=
# DB_SSLMODE=require

# Must resolve outside the public web root. Defaults to var/private-storage.
GARWIN_STORAGE_PATH=var/private-storage

# Select "webdav" to use a dedicated HTTPS cPanel Web Disk account.
# APP_STORAGE_DRIVER=webdav
# APP_STORAGE_WEBDAV_URL=https://your-host.example:2078/
# APP_STORAGE_WEBDAV_USERNAME=webdisk-user
# APP_STORAGE_WEBDAV_PASSWORD=
# Optional directory path relative to the Web Disk endpoint:
# APP_STORAGE_WEBDAV_ROOT=garwinai-private
