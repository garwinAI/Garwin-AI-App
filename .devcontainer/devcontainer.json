{
  "name": "GarwinAI",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.3-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "GarwinAI site",
      "onAutoForward": "openBrowser"
    }
  }
}
